# Secret file consumed by Docker. Copy to /etc/convive/backup-repository.env and chmod 0400.
# Production uses a private Cloudflare R2 Standard bucket in the EU jurisdiction.
RESTIC_REPOSITORY=s3:https://replace-with-account-id.eu.r2.cloudflarestorage.com/replace-with-private-bucket
RESTIC_PASSWORD=replace-with-an-independent-high-entropy-repository-password
AWS_ACCESS_KEY_ID=replace-with-least-privilege-key-id
AWS_SECRET_ACCESS_KEY=replace-with-least-privilege-secret
AWS_DEFAULT_REGION=auto
