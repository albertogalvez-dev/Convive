[Unit]
Description=Process and clean private Convive attachment lifecycle work
Requires=docker.service
After=docker.service
ConditionPathExists=/srv/convive/releases/current.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/srv/convive/current/infrastructure/maintenance/attachment-lifecycle.sh
TimeoutStartSec=10m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock

[Install]
WantedBy=multi-user.target
