[Unit]
Description=Convive observability and redacted smoke checks
After=docker.service
Requires=docker.service
OnFailure=convive-observability-alert.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/convive-observability-check
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/convive-observability
