[Unit]
Description=Convive encrypted PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/convive/backup-job.conf
ExecStart=/srv/convive/current/infrastructure/backup/backup.sh
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/convive-backup /run/lock

[Install]
WantedBy=multi-user.target
