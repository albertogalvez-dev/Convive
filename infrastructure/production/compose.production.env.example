# Copy to a root-owned runtime environment outside Git, then replace the image
# digests with the release manifest generated by CI.
CONVIVE_SECRET_DIR=/srv/platform/secrets/convive
CONVIVE_API_IMAGE=ghcr.io/albertogalvez-dev/convive/api@sha256:replace-with-release-digest
CONVIVE_GATEWAY_IMAGE=ghcr.io/albertogalvez-dev/convive/gateway@sha256:replace-with-release-digest
