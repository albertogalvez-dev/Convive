{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	@api path /api/v1/* /api/doc.json
	@attachment_upload {
		method POST
		path /api/v1/reporter/report/attachments
	}
	request_body @attachment_upload {
		max_size 16MiB
	}
	handle @api {
		header Cache-Control "no-store"
		php_fastcgi api:9000 {
			root /app/public
		}
	}

	handle {
		root * /srv/web
		try_files {path} /index.csr.html
		header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@fingerprinted path_regexp fingerprint \.(?:[0-9a-f]{8,})\.(?:js|css|svg|png|jpg|jpeg|webp|woff2?)$
}
