# This file is populated outside Git and mounted as /run/secrets/api_env.
APP_SECRET=replace-with-a-random-production-secret
DATABASE_URL=postgresql://convive:replace-with-database-password@database:5432/convive?serverVersion=18.4&charset=utf8
SESSION_DATABASE_URL=pgsql:host=database;port=5432;dbname=convive;user=convive;password=replace-with-database-password
# Use the same non-empty password as redis.conf, URL-encoded if necessary.
REDIS_DSN=redis://:replace-with-redis-password@redis:6379
# Required by `app:demo:seed`, which refuses to run unless this is present and
# contains at least 20 characters. Generate with: openssl rand -hex 32
# Without it the release deploys correctly and the demonstration has no data.
DEMO_PROFESSIONAL_PASSWORD=replace-with-at-least-20-random-characters
