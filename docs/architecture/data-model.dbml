// Convive — data model
//
// This file is derived, human-readable documentation of the first domain schema.
// The authoritative sources are the Doctrine mappings and the committed
// migrations (see apps/api/migrations). Render at https://dbdiagram.io.

Table organisations {
  id uuid [pk]
  name varchar(255) [not null]
  public_reporting_identifier varchar(20) [not null, unique, note: 'ORG_ prefix plus 16 Crockford Base32 characters; public routing identifier']
}

Table reports {
  id uuid [pk, note: 'application-generated UUIDv7']
  organisation_id uuid [not null]
  situation_description text [not null]
  situation_context varchar(20) [not null, note: 'in_person | digital | mixed | unknown (CHECK constraint)']
  status varchar(20) [not null, note: 'received | reviewed (CHECK constraint); independent from triage outcome']
  public_reference varchar(32) [not null, unique, note: 'non-sequential public tracking reference']
  access_secret_hash varchar(64) [not null, unique, note: 'lowercase hexadecimal SHA-256 lookup hash of the access secret; the secret is never stored']
  created_at timestamptz [not null, note: 'immutable UTC instant']
  review_reason text [note: 'bounded initial professional assessment; null until reviewed']
  reviewed_by_professional_id uuid [note: 'professional actor; null until reviewed']
  reviewed_at timestamptz [note: 'immutable UTC instant; null until reviewed']
  attachment_count int [not null, note: 'reserved attachment slots; non-negative']
  attachment_bytes int [not null, note: 'reserved attachment bytes; non-negative']
  version int [not null, note: 'optimistic-lock version']

  indexes {
    organisation_id
  }
}

Ref: reports.organisation_id > organisations.id
Ref: reports.reviewed_by_professional_id > professionals.id

Table report_attachments {
  id uuid [pk, note: 'application-generated UUIDv7; private object metadata only']
  report_id uuid [not null]
  media_type varchar(64) [not null, note: 'application/pdf | image/jpeg | image/png (CHECK constraint)']
  byte_size int [not null, note: '1 to 5 MiB (CHECK constraint)']
  content_hash varchar(64) [not null, note: 'lowercase hexadecimal SHA-256 integrity digest (CHECK constrained)']
  storage_key varchar(255) [not null, unique, note: 'private quarantine|available UUID key; never a public path']
  status varchar(32) [not null, note: 'quarantined | scanning | available | rejected | deletion_pending | deleted (CHECK constraint)']
  created_at timestamptz [not null, note: 'immutable UTC instant']
  scan_started_at timestamptz [note: 'null until scanning begins']
  resolved_at timestamptz [note: 'null until scanning resolves']
  deletion_requested_at timestamptz [note: 'null until deletion is requested']
  deleted_at timestamptz [note: 'null until object deletion completes']
  description varchar(500) [note: 'optional bounded reporter-supplied context; no filename is persisted']

  indexes {
    (report_id, status, created_at, id)
  }
}

Ref: report_attachments.report_id > reports.id

Table report_access_grants {
  id uuid [pk, note: 'application-generated UUIDv7']
  report_id uuid [not null]
  capability_hash varchar(64) [not null, unique, note: 'lowercase hexadecimal SHA-256 lookup hash of the capability handle; CHECK constrained to [0-9a-f]{64}']
  issued_at timestamptz [not null]
  last_used_at timestamptz [not null, note: 'refreshed on each valid use; drives the 15-minute idle timeout']
  absolute_expires_at timestamptz [not null, note: 'issued_at + 2 hours']
  revoked_at timestamptz [null, note: 'set once, on explicit revocation or replacement by a newly unlocked report']

  indexes {
    report_id
  }
}

Ref: report_access_grants.report_id > reports.id

Table report_follow_up_entries {
  id uuid [pk, note: 'application-generated UUIDv7']
  report_id uuid [not null]
  author_type varchar(20) [not null, note: 'reporter | professional (CHECK constraint); all entries are reporter-visible']
  professional_author_id uuid [note: 'private audit metadata; required only for professional-authored responses']
  content text [not null, note: 'bounded to 2000 characters by FollowUpEntryContent before persistence']
  created_at timestamptz [not null, note: 'immutable UTC instant; entries are append-only']

  indexes {
    report_id
  }
}

Ref: report_follow_up_entries.report_id > reports.id

Table managed_cases {
  id uuid [pk, note: 'application-generated UUIDv7']
  organisation_id uuid [not null]
  created_by_professional_id uuid [not null]
  created_at timestamptz [not null, note: 'immutable UTC instant']
  operational_updated_at timestamptz [not null, note: 'latest explicit case, assignment or task activity; deterministic operational ordering']
  status varchar(20) [not null, note: 'assessment | active | closed (CHECK constraint)']
  status_reason varchar(500) [note: 'nullable until the first explicit lifecycle transition']
  status_evidence varchar(500) [note: 'nullable until the first explicit lifecycle transition']
  status_changed_at timestamptz [note: 'nullable until the first explicit lifecycle transition']
  modality varchar(20) [not null, note: 'in_person | digital | mixed | unknown (CHECK constraint)']

  indexes {
    organisation_id
  }
}

Table case_audit_events {
  id uuid [pk, note: 'application-generated UUIDv7; append-only PostgreSQL record']
  case_id uuid [not null]
  organisation_id uuid [not null, note: 'copied from the case for scoped ordering; no organisation content']
  actor_professional_id uuid [not null]
  action varchar(40) [not null, note: 'minimised lifecycle | linkage | assignment | task | evidence-download | export action (CHECK constraint)']
  target varchar(30) [not null, note: 'minimised target category only; no target content in the audit response (CHECK constraint)']
  target_id uuid [not null, note: 'internal audit correlation only; never returned by the protected audit API']
  occurred_at timestamptz [not null, note: 'immutable UTC instant; fictional-demo retention is explicit and bounded']

  indexes {
    (case_id, occurred_at)
    (organisation_id, occurred_at)
  }
}

Table case_assignments {
  id uuid [pk]
  case_id uuid [not null]
  professional_id uuid [not null]
  role varchar(20) [not null, note: 'lead | contributor | observer (CHECK constraint)']
  assigned_by_professional_id uuid [not null]
  assigned_at timestamptz [not null]
  assignment_reason varchar(500) [note: 'minimised explicit reason']
  role_change_reason varchar(500) [note: 'latest minimised explicit role-change reason']
  revoked_at timestamptz [note: 'null while active; cannot precede assigned_at']
  revocation_reason varchar(500) [note: 'required for explicit revocation']

  indexes {
    (case_id, professional_id) [unique]
    (professional_id, revoked_at)
  }
}

Table case_involved_people {
  id uuid [pk]
  case_id uuid [not null]
  name varchar(120) [not null, note: 'bounded case-local operational identity; not an academic record']
  role varchar(20) [not null, note: 'affected | alleged_actor | witness | guardian | other (CHECK constraint)']
  added_by_professional_id uuid [not null]
  added_at timestamptz [not null]
  corrected_at timestamptz [note: 'nullable; latest explicit correction']
  removed_at timestamptz [note: 'nullable; logical removal retained for audit history']

  indexes {
    case_id
  }
}

Table case_workflow_source_versions {
  id uuid [pk, note: 'application-generated UUIDv7']
  code varchar(80) [not null]
  version varchar(40) [not null]
  title varchar(180) [not null]
  uri varchar(500) [note: 'required for binding and recommended sources']
  territory varchar(20) [not null]
  authority varchar(20) [not null, note: 'binding | recommended | internal (CHECK constraint)']
  published_on date [not null]
  reviewed_on date [not null, note: 'on or after published_on (CHECK constraint)']

  indexes {
    (code, version) [unique]
  }
}

Table case_workflow_task_templates {
  id uuid [pk, note: 'reviewed catalogue entry; application-generated UUIDv7']
  source_version_id uuid [not null]
  stage varchar(40) [not null, note: 'bounded protocol stage (CHECK constraint)']
  kind varchar(30) [not null, note: 'internal_action | external_communication (CHECK constraint)']
  title varchar(160) [not null, note: 'bounded editable task starting point; no case narrative']
  approved boolean [not null, note: 'only approved templates are selectable in the fictional Andalusian profile']
}

Table case_tasks {
  id uuid [pk, note: 'application-generated UUIDv7']
  case_id uuid [not null]
  owner_professional_id uuid [not null]
  source_version_id uuid [not null]
  stage varchar(40) [not null, note: 'bounded protocol stage (CHECK constraint)']
  kind varchar(30) [not null, note: 'internal_action | external_communication (CHECK constraint)']
  title varchar(160) [not null, note: 'bounded operational title; no case narrative']
  due_at timestamptz [not null, note: 'on or after created_at (CHECK constraint)']
  status varchar(20) [not null, note: 'pending | completed | not_applicable (CHECK constraint)']
  created_by_professional_id uuid [not null]
  created_at timestamptz [not null, note: 'immutable UTC instant']
  resolved_by_professional_id uuid [note: 'required for completed or not_applicable']
  resolved_at timestamptz [note: 'required for completed or not_applicable; on or after created_at']
  not_applicable_reason varchar(500) [note: 'required only for not_applicable']

  indexes {
    (case_id, status, due_at)
    (owner_professional_id, status, due_at)
  }
}

Table case_communications {
  id uuid [pk, note: 'append-only minimised communication record']
  case_id uuid [not null]
  responsible_professional_id uuid [not null]
  recipient varchar(30) [not null, note: 'family | external_service | education_inspectorate | other']
  channel varchar(30) [not null, note: 'in_person | telephone | secure_portal | written_record | other; does not send']
  status varchar(20) [not null, note: 'planned | recorded | not_applicable; never proves delivery or receipt']
  occurred_at timestamptz [not null]
  note varchar(500) [not null, note: 'bounded non-sensitive operational note']
  created_by_professional_id uuid [not null]
  created_at timestamptz [not null, note: 'immutable UTC instant']
  supersedes_communication_id uuid [note: 'traceable correction; original record is not edited']

  indexes { (case_id, occurred_at, id) }
}

Table report_triage_decisions {
  id uuid [pk, note: 'application-generated UUIDv7; append-only']
  report_id uuid [not null]
  organisation_id uuid [not null, note: 'copied from the report and protected by the application invariant']
  decided_by_professional_id uuid [not null]
  outcome varchar(20) [not null, note: 'keep | redirect | dismiss | link_to_case (CHECK constraint)']
  reason text [not null, note: 'trimmed 10–1000 characters (CHECK constrained)']
  decided_at timestamptz [not null, note: 'immutable UTC instant']
  terminal_report_id uuid [unique, note: 'null for keep; equal to report_id for the single terminal decision']
  case_id uuid [unique, note: 'present only for link_to_case']

  indexes {
    (report_id, decided_at, id)
    organisation_id
    decided_by_professional_id
  }
}

Ref: managed_cases.organisation_id > organisations.id
Ref: managed_cases.created_by_professional_id > professionals.id
Ref: case_audit_events.case_id > managed_cases.id
Ref: case_audit_events.organisation_id > organisations.id
Ref: case_audit_events.actor_professional_id > professionals.id
