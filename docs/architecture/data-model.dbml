Ref: case_workflow_task_templates.source_version_id > case_workflow_source_versions.id
Ref: case_tasks.created_by_professional_id > professionals.id
Ref: case_tasks.resolved_by_professional_id > professionals.id
Ref: case_communications.case_id > managed_cases.id
