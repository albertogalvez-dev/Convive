Ref: case_communications.created_by_professional_id > professionals.id
Ref: case_communications.supersedes_communication_id > case_communications.id
Ref: report_triage_decisions.report_id > reports.id
Ref: report_triage_decisions.organisation_id > organisations.id
Ref: report_triage_decisions.decided_by_professional_id > professionals.id
Ref: report_triage_decisions.terminal_report_id > reports.id
Ref: report_triage_decisions.case_id > managed_cases.id

Table professionals {
  id uuid [pk, note: 'application-generated UUIDv7']
  name varchar(255) [not null]
  email varchar(255) [not null, unique, note: 'normalised lowercase; never publicly discoverable']
  created_at timestamptz [not null, note: 'immutable UTC instant']
  password_hash varchar(255) [not null, note: 'Argon2id hash only; plaintext is never persisted']
  active boolean [not null]
  account_status varchar(20) [not null, note: 'invited | active | suspended | deactivated (CHECK constraint)']
  security_revision int [not null, note: 'increments on credential and lifecycle changes so stale sessions cannot continue']
}

Table professional_credential_invitations {
  id uuid [pk, note: 'application-generated UUIDv7']
  professional_id uuid [not null]
  issued_by_professional_id uuid [not null]
  purpose varchar(20) [not null, note: 'activation | password_reset (CHECK constraint)']
  secret_hash varchar(64) [not null, unique, note: 'SHA-256 lookup hash; plaintext one-time code is never persisted']
  expires_at timestamptz [not null]
  used_at timestamptz [note: 'set once after accepted before expiry']

  indexes { secret_hash }
}

Table professional_account_audit_events {
  id uuid [pk, note: 'application-generated UUIDv7; no credentials or content']
  target_professional_id uuid [not null]
  actor_professional_id uuid [not null]
  action varchar(32) [not null, note: 'invited | credential_accepted | password_reset_issued | suspended | reactivated | deactivated']
  occurred_at timestamptz [not null]

  indexes { (target_professional_id, occurred_at) }
}

Table professional_export_events {
  id uuid [pk, note: 'application-generated UUIDv7; append-only PostgreSQL record']
  professional_id uuid [not null]
  kind varchar(40) [not null, note: 'operational_overview only (CHECK constraint); no exported PDF or count is persisted']
  occurred_at timestamptz [not null, note: 'immutable UTC instant; fictional-demo retention is explicit and bounded']

  indexes {
    (professional_id, occurred_at)
  }
}

Table organisation_memberships {
  id uuid [pk, note: 'application-generated UUIDv7']
  professional_id uuid [not null]
  organisation_id uuid [not null]
  role varchar(20) [not null, note: 'triage | administrator (CHECK constraint)']
  granted_at timestamptz [not null]
  suspended_at timestamptz [note: 'temporary removal from every organisation-scoped action; preserves the historical row']
  revoked_at timestamptz [null, note: 'one row per (professional, organisation, role) forever; revocation clears this rather than deleting the row']

  indexes {
    professional_id
    organisation_id
    (professional_id, organisation_id, role) [unique]
  }
}

Table professional_notifications {
  id uuid [pk, note: 'application-generated UUIDv7']
  recipient_professional_id uuid [not null, note: 'the only professional who may read the row; delivery is recipient-specific, never broadcast']
  case_id uuid [not null, note: 'deep-link target only; access is re-authorised on every read, so a revoked recipient stops seeing the row']
  type varchar(30) [not null, note: 'case_assigned | case_lifecycle_changed (CHECK constraint)']
  created_at timestamptz [not null, note: 'immutable UTC instant']
  read_at timestamptz [null, note: 'set once when the recipient acknowledges; never reset']

  indexes {
    (recipient_professional_id, created_at, id)
  }

  note: 'Minimised in-product notifications. No report or case content is copied here: the row carries only a type, an instant and a case reference resolved through the normal access check.'
}

Table professional_notification_preferences {
  professional_id uuid [not null]
  notification_type varchar(30) [not null, note: 'case_lifecycle_changed only (CHECK constraint); safeguarding-required types are never persisted and cannot be disabled']
  enabled boolean [not null]

  indexes {
    (professional_id, notification_type) [pk, unique]
  }
}

Ref: organisation_memberships.professional_id > professionals.id
Ref: organisation_memberships.organisation_id > organisations.id
Ref: professional_notifications.recipient_professional_id > professionals.id
Ref: professional_notifications.case_id > managed_cases.id
Ref: professional_notification_preferences.professional_id > professionals.id
Ref: professional_export_events.professional_id > professionals.id
Ref: professional_credential_invitations.professional_id > professionals.id
