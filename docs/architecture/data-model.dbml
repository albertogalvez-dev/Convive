// Convive — data model
//
// This file is derived, human-readable documentation of the first domain schema.
// The authoritative sources are the Doctrine mappings and the committed
// migrations (see apps/api/migrations). Render at https://dbdiagram.io.

Table organisations {
  id uuid [pk]
  name varchar(255) [not null]
  public_reporting_identifier varchar(20) [not null, unique, note: 'ORG_ prefix plus 16 Crockford Base32 characters; public routing identifier']
}

Table reports {
  id uuid [pk, note: 'application-generated UUIDv7']
  organisation_id uuid [not null]
  situation_description text [not null]
  situation_context varchar(20) [not null, note: 'in_person | digital | mixed | unknown (CHECK constraint)']
  status varchar(20) [not null, note: 'received | reviewed (CHECK constraint); independent from triage outcome']
  public_reference varchar(32) [not null, unique, note: 'non-sequential public tracking reference']
  access_secret_hash varchar(64) [not null, unique, note: 'lowercase hexadecimal SHA-256 lookup hash of the access secret; the secret is never stored']
  created_at timestamptz [not null, note: 'immutable UTC instant']

  indexes {
    organisation_id
  }
}

Ref: reports.organisation_id > organisations.id
Ref: reports.reviewed_by_professional_id > professionals.id

Table report_access_grants {
  id uuid [pk, note: 'application-generated UUIDv7']
  report_id uuid [not null]
  capability_hash varchar(64) [not null, unique, note: 'lowercase hexadecimal SHA-256 lookup hash of the capability handle; CHECK constrained to [0-9a-f]{64}']
  issued_at timestamptz [not null]
  last_used_at timestamptz [not null, note: 'refreshed on each valid use; drives the 15-minute idle timeout']
  absolute_expires_at timestamptz [not null, note: 'issued_at + 2 hours']
  revoked_at timestamptz [null, note: 'set once, on explicit revocation or replacement by a newly unlocked report']

  indexes {
    report_id
  }
}

Ref: report_access_grants.report_id > reports.id

Table report_follow_up_entries {
  id uuid [pk, note: 'application-generated UUIDv7']
  report_id uuid [not null]
  author_type varchar(20) [not null, note: 'reporter | professional (CHECK constraint); all entries are reporter-visible']
  professional_author_id uuid [note: 'private audit metadata; required only for professional-authored responses']
  content text [not null, note: 'bounded to 2000 characters by FollowUpEntryContent before persistence']
  created_at timestamptz [not null, note: 'immutable UTC instant; entries are append-only']

  indexes {
    report_id
  }
}

Ref: report_follow_up_entries.report_id > reports.id

Table managed_cases {
  id uuid [pk, note: 'application-generated UUIDv7; minimal case identity introduced by #43']
  organisation_id uuid [not null]
  created_by_professional_id uuid [not null]
  created_at timestamptz [not null, note: 'immutable UTC instant']
  review_reason text [note: 'bounded initial professional assessment; null until reviewed']
  reviewed_by_professional_id uuid [note: 'professional actor; null until reviewed']
  reviewed_at timestamptz [note: 'immutable UTC instant; null until reviewed']
  attachment_count int [not null, note: 'reserved attachment slots; non-negative']
  attachment_bytes int [not null, note: 'reserved attachment bytes; non-negative']
  version int [not null, note: 'optimistic-lock version']

  indexes {
    organisation_id
  }
}

Table report_triage_decisions {
  id uuid [pk, note: 'application-generated UUIDv7; append-only']
  report_id uuid [not null]
  organisation_id uuid [not null, note: 'copied from the report and protected by the application invariant']
  decided_by_professional_id uuid [not null]
  outcome varchar(20) [not null, note: 'keep | redirect | dismiss | link_to_case (CHECK constraint)']
  reason text [not null, note: 'trimmed 10–1000 characters (CHECK constrained)']
  decided_at timestamptz [not null, note: 'immutable UTC instant']
  terminal_report_id uuid [unique, note: 'null for keep; equal to report_id for the single terminal decision']
  case_id uuid [unique, note: 'present only for link_to_case']

  indexes {
    (report_id, decided_at, id)
    organisation_id
    decided_by_professional_id
  }
}

Ref: managed_cases.organisation_id > organisations.id
Ref: managed_cases.created_by_professional_id > professionals.id
Ref: report_triage_decisions.report_id > reports.id
Ref: report_triage_decisions.organisation_id > organisations.id
Ref: report_triage_decisions.decided_by_professional_id > professionals.id
Ref: report_triage_decisions.terminal_report_id > reports.id
Ref: report_triage_decisions.case_id > managed_cases.id

Table professionals {
  id uuid [pk, note: 'application-generated UUIDv7']
  name varchar(255) [not null]
  email varchar(255) [not null, unique, note: 'normalised lowercase; authentication is out of scope until #30']
  created_at timestamptz [not null, note: 'immutable UTC instant']
}

Table organisation_memberships {
  id uuid [pk, note: 'application-generated UUIDv7']
  professional_id uuid [not null]
  organisation_id uuid [not null]
  role varchar(20) [not null, note: 'triage | administrator (CHECK constraint)']
  granted_at timestamptz [not null]
  revoked_at timestamptz [null, note: 'one row per (professional, organisation, role) forever; revocation clears this rather than deleting the row']

  indexes {
    professional_id
    organisation_id
    (professional_id, organisation_id, role) [unique]
  }
}

Ref: organisation_memberships.professional_id > professionals.id
Ref: organisation_memberships.organisation_id > organisations.id
