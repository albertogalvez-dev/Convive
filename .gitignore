# JetBrains IDE
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Local environment files
.env.local
.env.*.local

# Logs
*.log

# Populated backup configuration and local recovery evidence
infrastructure/backup/backup-job.conf
infrastructure/backup/backup-repository.env
infrastructure/backup/evidence/

# Generated reporting posters (npm run poster). Reproducible from an
# identifier, so the output is not committed.
posters/

# Angular build cache. Regenerated on every build; never a repository artefact.
.angular/

# Claude Code local state and agent worktrees. A worktree contains a full copy
# of the repository including node_modules, so committing this directory
# duplicates the project inside itself.
.claude/

# Local scratch notes (meeting briefings, drafts). Useful, not repository
# content.
apuntes-*.html
